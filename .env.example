# ==========================================================
# WALLEX AGENTIC AI SPOT TRADING ENGINE - ENVIRONMENT CONFIG
# ==========================================================

# 1. Wallex Exchange API Key (Contest Account)
WALLEX_API_KEY="your_wallex_contest_api_key_here"
WALLEX_BASE_URL="https://api.wallex.ir"

# 2. Execution Mode: SHADOW (Recommended first) | LIVE | BACKTEST
EXECUTION_MODE="SHADOW"

# 3. Contest Capital & Risk Settings
INITIAL_CAPITAL_TMN="5000000.0"
MAX_POSITION_PCT="0.22"
MIN_CASH_RESERVE_PCT="0.20"
MAX_CONCURRENT_POSITIONS="3"
MAX_SPREAD_PCT="0.25"
HARD_STOP_LOSS_PCT="0.012"
DEFAULT_TAKE_PROFIT_PCT="0.022"
TRAILING_STOP_ACTIVATION_PCT="0.010"
TRAILING_STOP_DISTANCE_PCT="0.007"
MAX_PORTFOLIO_DRAWDOWN_PCT="0.035"
STALE_ORDER_TIMEOUT_SECONDS="180"
LOOP_INTERVAL_SECONDS="45"
FEE_RATE="0.002"

# 4. Contest Liquidation Deadline (Unix Timestamp)
# e.g. Friday 23:59:59 UTC
CONTEST_END_TIMESTAMP="1792771200"
FLATTEN_MINUTES_BEFORE_END="25"

# 5. LLM Strategist Configuration (BoxAPI / GPT-6 Luna)
LLM_API_KEY="your_boxapi_key_here"
LLM_BASE_URL="https://ai.boxapi.ir/ai/v1"
LLM_MODEL="gpt-6-luna"
LLM_REASONING_EFFORT="medium"

# Alternatives:
# LLM_MODEL="gpt-5.4-mini"
# LLM_MODEL="gpt-6-astra"
